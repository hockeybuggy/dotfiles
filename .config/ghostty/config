theme = dark:iTerm2 Solarized Dark,light:iTerm2 Solarized Light
font-family = InconsolataLGC Nerd Font
font-size = 17

# Treat Option as Alt/Meta so Option-key shortcuts work (e.g. Claude
# Code's Option+Enter for newlines and Option+P to switch models).
macos-option-as-alt = true

# In mouse-reporting mode this multiplier scales the *number* of wheel events
# sent to the app, not a distance. At the discrete default of 3, one notch sends
# three events, and herdr moves ui.mouse_scroll_lines for each -- so a stray
# flick jumped ~9 lines up the scrollback. One event per notch is also what most
# apps expect. The trackpad (`precision:`) stays at its default: the only lever
# there is deltas rounding down to zero, which makes each flick scroll or not
# scroll at random, and it would slow nvim down too.
mouse-scroll-multiplier = discrete:1
